# Copy these values to Replit Secrets or a local .env file.
# Never commit real keys or passwords.

FLASK_SECRET_KEY=replace-with-a-random-secret
ORDERGUARD_DB=orderguard.db

# Optional AI extraction. The app still works with human-confirmed fields when omitted.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
